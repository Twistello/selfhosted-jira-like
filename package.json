{
  "name": "forgeboard", "version": "0.1.0", "private": true, "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.server.json server/main.ts", "web": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.server.json && node ops/copy-migrations.mjs", "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --tsconfig tsconfig.server.json --test tests/*.test.ts", "test:e2e": "playwright test", "lint": "eslint server web tests",
    "migrate": "tsx server/migrate.ts", "start": "node dist/server/main.js",
    "backup": "node ops/database.mjs backup", "restore": "node ops/database.mjs restore",
    "check:secrets": "node ops/check-secrets.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0", "@nestjs/core": "^11.1.0", "@nestjs/platform-express": "^11.1.0", "@nestjs/swagger": "^11.2.0",
    "argon2": "^0.44.0", "cookie-parser": "^1.4.7", "dotenv": "^17.2.0", "express": "^5.1.0", "helmet": "^8.1.0", "express-rate-limit": "^8.2.0",
    "pg": "^8.16.0", "qrcode": "^1.5.4", "react": "^19.2.0", "react-dom": "^19.2.0", "react-markdown": "^10.1.0", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "zod": "^4.1.0", "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0", "@types/cookie-parser": "^1.4.9", "@types/express": "^5.0.5", "@types/node": "^24.10.0", "@types/pg": "^8.15.0", "@types/qrcode": "^1.5.6", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.1.0", "eslint": "^9.39.0", "typescript-eslint": "^8.46.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.2.0"
  }
}
